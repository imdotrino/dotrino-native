<?xml version="1.0" encoding="utf-8"?>
<!-- Toda app que usa la librería habla con la app de identidad (IdentityClient): necesita
     verla (visibilidad de paquetes, Android 11+) y el permiso de firma de su servicio. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="com.dotrino.permission.IDENTITY" />
    <!-- La librería habla con el proxio (ProxyConnection, BroadcastHost). Sin esto, OkHttp
         lanza un SecurityException en su propio hilo y tumba la app entera. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The profile pages (DotrinoWebActivity) read a pairing QR with the camera. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <queries>
        <package android:name="com.dotrino.identity" />
        <!-- Las apps del catálogo (DotrinoApps): saber si están instaladas para abrirlas o instalarlas. -->
        <package android:name="com.dotrino.app" />
    </queries>
    <application>
        <!-- A page of the ecosystem inside the app, with the phone's identity (profile, create, adopt, sign in). -->
        <activity android:name="com.dotrino.sdk.ui.DotrinoWebActivity" android:exported="false"
            android:theme="@android:style/Theme.Material.Light.NoActionBar"
            android:configChanges="orientation|screenSize|keyboardHidden" />
    </application>
</manifest>
