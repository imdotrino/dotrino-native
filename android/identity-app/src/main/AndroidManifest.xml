<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- ESTA APP NO SE CONECTA A INTERNET NI USA LA CÁMARA, y lo dice la política publicada. La
         librería los pide para las demás apps (el proxio, leer un QR): aquí se quitan. Su
         pantalla va sin botón de perfil, que es lo único que abriría una página web. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.CAMERA" tools:node="remove" />

    <!-- Solo lo usan apps firmadas con la MISMA llave que esta: las de Dotrino. -->
    <permission
        android:name="com.dotrino.permission.IDENTITY"
        android:protectionLevel="signature"
        android:label="@string/permission_label" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/dotrino_locales_config"
        android:supportsRtl="true">

        <activity
            android:name=".InfoActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <!-- Sin icono en el inicio: es una app de apoyo, no hace falta abrirla ni hay acceso
                 desde las demás (dueño, 2026-09-28). Esta acción solo sirve para abrirla a mano
                 en pruebas: `adb shell am start -a com.dotrino.identity.OPEN`. -->
            <intent-filter>
                <action android:name="com.dotrino.identity.OPEN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".IdentityService"
            android:exported="true"
            android:permission="com.dotrino.permission.IDENTITY" />
    </application>
</manifest>
