<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Solo lo usan apps firmadas con la MISMA llave que esta: las de Dotrino. -->
    <permission
        android:name="com.dotrino.permission.IDENTITY"
        android:protectionLevel="signature"
        android:label="@string/permission_label" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/dotrino_locales_config"
        android:supportsRtl="true">

        <activity
            android:name=".InfoActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".IdentityService"
            android:exported="true"
            android:permission="com.dotrino.permission.IDENTITY" />
    </application>
</manifest>
